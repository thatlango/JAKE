NODE_ENV=production
PORT=3000
PUBLIC_URL=https://jakeos.tukutuku.org
DATABASE_URL=postgresql://jakeos:change-me@jakeos-db:5432/jakeos
PG_POOL_MAX=8

ANTHROPIC_API_KEY=
GROQ_API_KEY=
SMS_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jakeos.tukutuku.org/auth/google/callback

# Tuku Core connection. On the VPS use the internal service URL so estate
# telemetry and Momentum authentication never hair-pin through public DNS.
TUKU_CORE_URL=http://tuku-core-api:3000
TUKU_ESTATE_INSIGHTS_SECRET=
ESTATE_CACHE_TTL_MS=60000
TUKU_CORE_AUTH_TIMEOUT_MS=5000
TUKU_CORE_AUTH_CACHE_SECONDS=30

# Momentum authenticates with normal first-party Tuku Core access tokens.
# Restrict a personal JakeOS instance to its canonical Core user ID(s).
MOMENTUM_ALLOWED_CORE_USER_IDS=
# Optional compatibility allowlists for older Firebase clients.
MOMENTUM_ALLOWED_UIDS=
MOMENTUM_ALLOWED_EMAILS=
MOMENTUM_FIREBASE_PROJECT_ID=
# Development/emergency fallback only when Tuku Core/Firebase are not configured.
MOMENTUM_API_TOKEN=

# Server-to-server ingestion from other work systems into JakeOS.
JAKEOS_INGEST_TOKEN=

# VPS-native scheduled jobs.
JOBS_ENABLED=true
JOBS_TIMEZONE=Africa/Kampala
