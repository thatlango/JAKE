NODE_ENV=production
PORT=3000
PUBLIC_URL=https://jakeos.tukutuku.org
DATABASE_URL=postgresql://jakeos:change-me@jakeos-db:5432/jakeos
PG_POOL_MAX=8

ANTHROPIC_API_KEY=
GROQ_API_KEY=
SMS_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jakeos.tukutuku.org/auth/google/callback

# Tuku Core estate telemetry. Keep the shared secret server-side only.
TUKU_CORE_URL=https://auth.tukutuku.org
TUKU_ESTATE_INSIGHTS_SECRET=
ESTATE_CACHE_TTL_MS=60000

# Momentum verifies Firebase ID tokens from this Firebase project.
MOMENTUM_FIREBASE_PROJECT_ID=
# Optional personal allowlist. Comma-separated Firebase uid(s) and/or email(s).
MOMENTUM_ALLOWED_UIDS=
MOMENTUM_ALLOWED_EMAILS=
# Development/emergency fallback only when Firebase verification is not configured.
MOMENTUM_API_TOKEN=

# Server-to-server ingestion from other work systems into JakeOS.
JAKEOS_INGEST_TOKEN=

# Dedicated Opportunities machine connector.
# The server binds this credential to exactly opportunities:read and opportunities:write.
# It cannot access other JakeOS APIs and the connector exposes no hard-delete route.
JAKEOS_OPPORTUNITIES_CONNECTOR_TOKEN=

# Dedicated Tuku Agent OS telemetry connector.
# Never expose this token in browser bundles. It only accepts agent runs/events/artifacts/decisions.
JAKEOS_AGENT_CONNECTOR_TOKEN=
AGENT_STALE_MINUTES=10

# VPS-native scheduled jobs.
JOBS_ENABLED=true
JOBS_TIMEZONE=Africa/Kampala

# TukuPay server-side ops integration (never expose token to browser bundles)
TUKUPAY_BASE_URL=http://tukupay-api:8080
TUKUPAY_TOKEN=
