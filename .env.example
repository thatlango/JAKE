ANTHROPIC_API_KEY=

# Supabase API credentials used by server/db.js (required for DB access in this app)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional fallback if SERVICE key is not set (reduced permissions vs service role)
SUPABASE_ANON_KEY=

# Optional: direct Postgres connection string (URL can be auto-derived from this host)
# Example:
# postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_CONNECTION_STRING=

# Note: SUPABASE_DB_PASSWORD is NOT used by this app directly.
# This app connects through the Supabase REST API client, not a direct Postgres socket.
SUPABASE_DB_PASSWORD=
